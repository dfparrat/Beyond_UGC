PORT=4000
PUBLIC_SITE_URL=http://127.0.0.1:5500

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=optional_webhook_id

MP_ACCESS_TOKEN=your_mercado_pago_access_token
MP_NOTIFICATION_URL=https://your-public-domain.com/api/webhooks/mercadopago

# Optional override URLs
PAYPAL_RETURN_URL=http://127.0.0.1:5500/pricing.html?payment=success&provider=paypal
PAYPAL_CANCEL_URL=http://127.0.0.1:5500/pricing.html?payment=cancelled&provider=paypal
MP_SUCCESS_URL=http://127.0.0.1:5500/pricing.html?payment=success&provider=mercadopago
MP_PENDING_URL=http://127.0.0.1:5500/pricing.html?payment=pending&provider=mercadopago
MP_FAILURE_URL=http://127.0.0.1:5500/pricing.html?payment=failed&provider=mercadopago
